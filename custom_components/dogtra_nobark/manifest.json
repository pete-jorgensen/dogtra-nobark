{
  "domain": "dogtra_nobark",
  "name": "Dogtra SMART NOBARK (Bluetooth)",
  "bluetooth": [
    {
      "local_name": "DOGTRA_*",
      "connectable": true
    }
  ],
  "codeowners": [
    "@pete-jorgensen"
  ],
  "config_flow": true,
  "dependencies": [
    "bluetooth_adapters"
  ],
  "documentation": "https://github.com/pete-jorgensen/dogtra-nobark",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/pete-jorgensen/dogtra-nobark/issues",
  "requirements": [
    "bleak-retry-connector>=3.5.0"
  ],
  "version": "0.1.0"
}
