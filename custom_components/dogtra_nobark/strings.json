{
  "config": {
    "flow_title": "{name}",
    "step": {
      "confirm": {
        "description": "Add {name}?\n\nThe integration reads the collar's status (bark, howl and whine counts, battery, mode and settings) and can send it commands: Page, Nick, the correction mode, the correction level and the two sensitivities. Nick delivers stimulation to the dog; its level is capped in this integration's options."
      },
      "user": {
        "data": {
          "address": "Collar"
        },
        "description": "Choose a Dogtra SMART NOBARK collar. Only collars currently in range of a Bluetooth adapter or proxy are listed. If the Dogtra phone app is open, the collar is connected to the phone and will not appear -- close the app first."
      }
    },
    "abort": {
      "already_configured": "This collar is already configured.",
      "no_devices_found": "No Dogtra collar found. Make sure it is switched on, in range of a Bluetooth adapter or proxy, and that the Dogtra phone app is closed.",
      "not_supported": "This device is not a Dogtra SMART NOBARK collar."
    }
  },
